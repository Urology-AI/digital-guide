# Copy to .env for local dev. .env is gitignored.
# In CI (GitHub Pages) these are set as repo Variables — see
# .github/workflows/deploy-pages.yml.

# Existing Python chat/TTS backend (avatar chat view) — currently unmounted.
VITE_API_BASE_URL=
VITE_SPEECH_API_BASE_URL=

# Patient guide chat → Cloudflare Worker (see worker/). Deployed:
VITE_COMPASS_CHAT_URL=https://compass-chat-proxy.e-psa.workers.dev

# Cloudflare Turnstile SITE key (public — the SECRET key goes on the worker via
# `wrangler secret put TURNSTILE_SECRET_KEY`). Add hostnames in the Turnstile
# dashboard: www.urology.edu.eu.org and localhost.
# Local always-pass test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEd5DVBFQAaeSWNY
